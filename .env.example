# Copy to .env for local runs. In GitLab, set these under Settings > CI/CD > Variables instead.

# Optional: bearer token CDI must send to the agent. Overrides the fixed token in src/agent.js.
RPA_AGENT_TOKEN=
RPA_AGENT_PORT=3100
RPA_AGENT_ID=rpa-agent-local
RPA_RUN_RETENTION_MINUTES=60
# Max concurrent runs (each launches a Chrome); extra POST /agent/runs get 429
RPA_MAX_ACTIVE_RUNS=3

# Site credentials referenced by src/siteConfigs.js
CDI_UAT_USERNAME=
CDI_UAT_PASSWORD=
