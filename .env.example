# Copy to .env for local runs. In GitLab, set these under Settings > CI/CD > Variables instead.

# Required: bearer token CDI must send to the agent. Agent refuses to start without it.
RPA_AGENT_TOKEN=
RPA_AGENT_PORT=3100
RPA_AGENT_ID=rpa-agent-local
RPA_RUN_RETENTION_MINUTES=60

# Outbound run-event reporting to CDI (optional; skipped when CDI_BASE_URL is empty)
CDI_BASE_URL=
CDI_API_TOKEN=

# Site credentials referenced by src/siteConfigs.js
CDI_UAT_USERNAME=
CDI_UAT_PASSWORD=
