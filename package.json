{
  "name": "rpa-mfa-playwright",
  "version": "1.0.0",
  "description": "支持短信MFA人工介入的 Playwright RPA Web 应用",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "agent": "node --env-file-if-exists=.env src/agent.js",
    "codegen": "playwright codegen"
  },
  "dependencies": {
    "express": "^4.19.2",
    "playwright": "^1.47.0",
    "ws": "^8.18.0"
  }
}
